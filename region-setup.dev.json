{
  "version": 1,
  "region": "DE",
  "languages": {
    "default": "de",
    "install": ["pl"]
  },
  "locale": {
    "country": "CH",
    "state": "BE",
    "timeZone": "Europe/Berlin",
    "calendarSelection": { "country": "CH", "state": "BE" }
  },
  "calendar": {
    "weekendDays": "Saturday,Sunday",
    "weekStartDay": "Monday"
  },
  "worktime": {
    "defaultWorkingHours": 8,
    "overtimeThreshold": 40,
    "vacationDaysPerYear": 24,
    "maxDailyHours": 10,
    "maxWeeklyHours": 48,
    "maxConsecutiveDays": 6,
    "minRestDays": 1,
    "minPauseHours": 11
  },
  "surcharges": {
    "nightRate": 0.25,
    "holidayRate": 1.0,
    "we1Rate": 0.5,
    "we2Rate": 0.5,
    "we3Rate": 0
  },
  "export": {
    "enabledFormats": ["datev", "generic-payroll-csv"],
    "defaultPayrollTargetSystem": "datev-lug-bewegungsdaten"
  },
  "compliance": {
    "periodCaps": [
      { "period": "year", "scope": "totalHours", "capHours": 1900 },
      { "windowWeeks": 17, "maxAverageWeeklyHours": 48 }
    ]
  },
  "seedDemoData": true
}
