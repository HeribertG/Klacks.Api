{
  "skills": [
    {
      "name": "get_email_settings",
      "className": "GetEmailSettingsSkill",
      "description": "Reads the current outgoing email (SMTP) settings. Returns server, port, timeout, SSL, authentication type, disposition notification, read receipt, reply-to, mark and SMTP username. Does NOT return the password.",
      "category": "Query",
      "effect": "Read",
      "requiredPermissions": ["CanViewSettings"],
      "resultMessage": "Email settings retrieved successfully.",
      "fields": [
        { "constant": "Constants.Settings.APP_OUTGOING_SERVER", "resultName": "OutgoingServer" },
        { "constant": "Constants.Settings.APP_OUTGOING_SERVER_PORT", "resultName": "Port" },
        { "constant": "Constants.Settings.APP_OUTGOING_SERVER_TIMEOUT", "resultName": "Timeout" },
        { "constant": "Constants.Settings.APP_ENABLE_SSL", "resultName": "EnabledSSL" },
        { "constant": "Constants.Settings.APP_AUTHENTICATION_TYPE", "resultName": "AuthenticationType" },
        { "constant": "Constants.Settings.APP_DISPOSITION_NOTIFICATION", "resultName": "DispositionNotification" },
        { "constant": "Constants.Settings.APP_READ_RECEIPT", "resultName": "ReadReceipt" },
        { "constant": "Constants.Settings.APP_REPLY_TO", "resultName": "ReplyTo" },
        { "constant": "Constants.Settings.APP_MARK", "resultName": "Mark" },
        { "constant": "Constants.Settings.APP_OUTGOING_SERVER_USERNAME", "resultName": "SmtpUsername" }
      ],
      "sensitiveFields": []
    },
