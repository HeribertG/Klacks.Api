# Klacks On-Prem (Docker) configuration.
# install.ps1 / install.sh generates a real .env from this template. Do not commit a filled .env.

# --- Compose project ---------------------------------------------------------
# Pinned so the host and the in-container updater operate on the SAME compose
# project regardless of the install directory name. Do not change after install.
COMPOSE_PROJECT_NAME=klacks

# --- Host / TLS --------------------------------------------------------------
# Hostname or IP clients use to reach Klacks. Used for the nginx server_name,
# the TLS certificate CN, JWT audience/issuer and CORS.
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- Region setup (optional, one-time on first boot) --------------------------
# Set by install.ps1 -Region / REGION=<code> ./install.sh. Path inside the
# klacks-api container to a regions/<code>.json profile (locale, holidays,
# worktime limits, surcharges, industry presets — see regions/README.md).
# Leave empty to skip region setup.
REGION_SETUP_FILE=

# --- Secrets (generated by the installer — keep stable across re-runs) --------
# POSTGRES_PASSWORD is baked into the postgres data volume on first init; changing
# it later orphans the database. JWT_SECRET signs sessions; changing it logs everyone out.
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Image versions ----------------------------------------------------------
# api/ui are pinned to an exact released version (set by the installer from the
# signed manifest) so both move together. The updater rides :latest (it is never
# part of the signed manifest and only swaps api/ui).
KLACKS_API_TAG=latest
KLACKS_UI_TAG=latest
KLACKS_UPDATER_TAG=latest

# --- Auto-update trust root (FIXED vendor values — do NOT randomize) ----------
# The manifest URL and the RSA public key are vendor constants. The public key
# must match the private key the vendor CI signs releases with.
UPDATE_MANIFEST_BASE_URL=https://github.com/HeribertG/Klacks.Api/releases/latest/download
UPDATE_SIGNATURE_PUBLIC_KEY=

# --- Marketplace (region packages / language plugins) -------------------------
# Public vendor marketplace used for region-package auto-updates and language
# plugin downloads. Override only for mirrored or air-gapped setups.
KLACKS_MARKETPLACE_URL=https://klacks-software.ch:7553

# --- SignalR backplane (optional, only for more than one API instance) --------
# Unset or empty means one klacks-api instance and the in-process behaviour every
# installation runs today. The installer does NOT write this key, and it does not
# have to: absent resolves to empty, which is the safe default. Add the line by
# hand only when a second instance is actually started. Klacks ships no such
# server: run any RESP-compatible one yourself (for example Valkey, which is
# BSD-3-licensed unlike Redis since 7.4), point this at its host and port -
# e.g. valkey:6379 - and switch the proxy to the sticky (ip_hash) upstream
# commented out in nginx/nginx.onprem.conf.template.
SIGNALR_BACKPLANE_CONNECTIONSTRING=

# --- Host sizing / klacks-api resource limits (optional overrides) ------------
# MINIMUM HOST: 8 GB RAM and 4 vCPU. klacks-api runs the retrieval models
# (embedder + reranker) locally in-process, and both ONNX sessions stay resident
# for the lifetime of the process. Measured on the vendor's production host
# 2026-09-12: they settle on a 2304 MB plateau (1017 MB base + 1171 MB embedder
# + 116 MB reranker); under a 2560M cap the kernel OOM-killed the container at
# 2471 MB. Hence the compose defaults 3584M / 3.0 CPUs, and idle unloading off.
# Memory caps across the stack add up to 3584 + 2048 (postgres) + 3 x 256
# (ui, updater, proxy) = 6400 MiB, leaving the rest of 8 GB for the OS and page
# cache. CPU quotas add up to 4.75 on 4 vCPU on purpose: a quota is a ceiling,
# not a reservation, and the services never peak together.
#
# The installer never writes these three keys - leaving them out keeps the
# compose defaults. Add a line by hand to adapt to the host; a re-run of the
# installer preserves every key already present in .env.
#
# Host with about 3 GB to spare for klacks-api: set BOTH of the next two lines,
# never the memory line on its own. Idle unloading disposes a session that has
# gone unused for 30 minutes and returns its memory, at the cost of a reload on
# the next question after such a gap (~2.2-2.9 s embedder, ~1.1 s reranker).
# Values between 1 and 5 are raised to 5; 0 means never unload.
# KLACKS_API_MEMORY_LIMIT=2560M
# KLACKS_API_IDLE_UNLOAD_MINUTES=30
#
# Host with fewer cores: retrieval keeps working, it only gets slower. The
# reranker is the CPU-bound stage - 2994-3163 ms per 25 candidates at 3.0 CPUs
# against 4339-4860 ms at 1.5, where it also spent 7.15 s throttled in two
# minutes.
# KLACKS_API_CPU_LIMIT=1.5
#
# NOT a memory option: KnowledgeIndex__WarmupEnabled=false. It only moves the
# session build out of start-up and into the first chat request; the sessions
# are just as resident afterwards, so it saves nothing in steady state. Use it
# only if the host runs out of memory while starting up.

# --- Auto-update behavior (DB settings override these; set via the admin UI) --
# Defaults applied on first boot. Leave AUTO_ENABLED=true for hands-off updates,
# or set NOTIFY_ONLY=true to detect-but-not-apply.
# UPDATE_AUTO_ENABLED=true
# UPDATE_NOTIFY_ONLY=false
