worker_processes auto;

# Error log: crit only. At the default level (error) nginx writes the raw request line into every
# upstream failure and 413 message - `request: "GET /hubs/x?id=1&access_token=<JWT>"`, the upstream
# URL and the referrer - and an error_log cannot be redacted like the access log. SignalR
# reconnects hit a dead upstream on every klacks-api release, so those lines are guaranteed to
# appear. The diagnostics they carried now live in the access log ($upstream_status etc. below).
# Residual: crit-level messages that name a request (e.g. an unreadable temp or cache file) would
# still print it; none occurs in this setup.
error_log /dev/stderr crit;

events {
    worker_connections 2048;
}

http {
    client_max_body_size 50m;

    proxy_connect_timeout 10s;
    proxy_read_timeout 300s;
    proxy_send_timeout 120s;
    proxy_buffer_size 16k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Access log without credentials.
    #
    # The default "combined" format logs $request, i.e. the raw request line including the query
    # string. SignalR cannot send an Authorization header over WebSockets, so the browser puts the
    # JWT into the URL (/hubs/...?id=...&access_token=<JWT>, devknowledge: /ws?token=<JWT>). A JWT
    # carries e-mail, name, role and user id, and every one of those lines ended up in the Docker
    # log. This format therefore never writes a query-string secret:
    #   1. /hubs/ and /ws: the whole query string is replaced (all of it is connection state).
    #   2. Everywhere else: the value of every known secret parameter is replaced by REDACTED.
    #      nginx maps cannot do a global replace, so three chained stages handle up to three secret
    #      parameters per request; the (?!REDACTED) guard makes a stage skip what an earlier stage
    #      already replaced, so each stage takes the last remaining one. A fourth stage fails
    #      closed and drops the whole query string.
    #   3. The Referer loses its query string (a page URL can carry the same parameters).
    # A parameter counts as secret when its NAME ends (case-insensitive) in token, secret, password,
    # passwd, pwd, key, code, auth, jwt, sig, signature, session or credential - so access_token,
    # hub.verify_token, apiKey, client_secret and refreshToken are all caught. This errs on the safe
    # side: names such as keyword or zipcode are redacted too.
    # NOT covered: URL-encoded parameter names (access%5Ftoken=...), ';' as parameter separator, and
    # secrets in the PATH. A name outside the suffix list is not caught either - extend the
    # alternation in the three stages and in the fail-closed stage together.
    map $request_uri $log_uri_stage0 {
        ~^(?<log_hub_path>/(?:hubs|ws)(?:/[^?]*)?)\?    "${log_hub_path}?REDACTED";
        default                                         $request_uri;
    }

    map $log_uri_stage0 $log_uri_stage1 {
        ~*^(?<log_pre1>.*[?&])(?<log_name1>[\w.\-]*(?:token|secret|passw(?:or)?d|pwd|key|code|auth|jwt|sig(?:nature)?|session|credential))=(?!REDACTED(?:&|$))[^&]*(?<log_post1>.*)$    "${log_pre1}${log_name1}=REDACTED${log_post1}";
        default                                         $log_uri_stage0;
    }

    map $log_uri_stage1 $log_uri_stage2 {
        ~*^(?<log_pre2>.*[?&])(?<log_name2>[\w.\-]*(?:token|secret|passw(?:or)?d|pwd|key|code|auth|jwt|sig(?:nature)?|session|credential))=(?!REDACTED(?:&|$))[^&]*(?<log_post2>.*)$    "${log_pre2}${log_name2}=REDACTED${log_post2}";
        default                                         $log_uri_stage1;
    }

    map $log_uri_stage2 $log_uri_stage3 {
        ~*^(?<log_pre3>.*[?&])(?<log_name3>[\w.\-]*(?:token|secret|passw(?:or)?d|pwd|key|code|auth|jwt|sig(?:nature)?|session|credential))=(?!REDACTED(?:&|$))[^&]*(?<log_post3>.*)$    "${log_pre3}${log_name3}=REDACTED${log_post3}";
        default                                         $log_uri_stage2;
    }

    # Fail closed: a fourth secret parameter in one request is not worth a fourth stage - if one is
    # still left after three, the whole query string is dropped instead of leaking it.
    map $log_uri_stage3 $log_uri_redacted {
        ~*^(?<log_failsafe_path>[^?]*)\?(?:.*&)?[\w.\-]*(?:token|secret|passw(?:or)?d|pwd|key|code|auth|jwt|sig(?:nature)?|session|credential)=(?!REDACTED(?:&|$))    "${log_failsafe_path}?REDACTED";
        default                                         $log_uri_stage3;
    }

    map $http_referer $log_referer_redacted {
        ~^(?<log_referer_path>[^?]*)\?                  "${log_referer_path}?REDACTED";
        default                                         $http_referer;
    }

    log_format redacted '$remote_addr - $remote_user [$time_local] '
                        '"$request_method $log_uri_redacted $server_protocol" '
                        '$status $body_bytes_sent "$log_referer_redacted" "$http_user_agent" '
                        'upstream_status=$upstream_status upstream_addr=$upstream_addr '
                        'upstream_response_time=$upstream_response_time request_time=$request_time';

    # Defined once here at http level and inherited by every server block below; no server or
    # location block may declare its own access_log, or it would bypass the redaction.
    access_log /var/log/nginx/access.log redacted;

    upstream klacks-ui {
        server klacks-ui:80;
        keepalive 32;
    }

    upstream klacks-api {
        server klacks-api:5000;
        keepalive 32;
    }

    # Sticky upstream for TWO API instances - deliberately NOT active. Exactly one klacks-api runs
    # today, and a second server entry pointing at a host that does not exist would answer 502 for
    # every request that hashes to it. To switch on, REPLACE the upstream block above with the one
    # commented out at the end of this note.
    #
    # SignalR needs the requests belonging to one connection to keep landing on the SAME instance:
    #   - negotiation hands out a connection token that only the answering instance knows, so the
    #     follow-up connect request must reach that very instance;
    #   - the Angular client falls back to LongPolling wherever WebSockets are blocked, and every
    #     poll and every send is then its own HTTP request that has to find its connection again.
    # An established WebSocket survives without stickiness because it stays one pinned socket - the
    # negotiation and the LongPolling fallback do not. That is why a Redis backplane alone is not
    # enough: it fans messages out across instances, it does not route a client back to its own.
    #
    # ip_hash must stand BEFORE keepalive - nginx requires a non-round-robin balancing method to be
    # activated before that directive. ip_hash keys on the client address, so everyone behind one
    # corporate NAT or CDN lands on the same instance; where a trusted proxy sets the header,
    # "hash $http_x_forwarded_for consistent;" spreads more evenly (cookie-based stickiness is an
    # NGINX Plus feature and not available here).
    #
    # Enabling this also requires SignalR__Backplane__ConnectionString on EVERY instance, otherwise
    # a push still only reaches the clients hanging on the instance that sent it.
    #
    # upstream klacks-api {
    #     ip_hash;
    #     server klacks-api:5000;
    #     server klacks-api-2:5000;
    #     keepalive 32;
    # }

    upstream klacks-blazor {
        server klacks-blazor:80;
        keepalive 32;
    }

    upstream klacks-marketplace {
        server klacks-marketplace:80;
        keepalive 32;
    }

    upstream klacks-marketing {
        server klacks-marketing:80;
        keepalive 32;
    }

    upstream devknowledge-ui {
        server devknowledge-ui:80;
        keepalive 32;
    }

    upstream devknowledge-api {
        server devknowledge-api:8080;
        keepalive 32;
    }

    # Security Headers
    #
    # WARNING: nginx add_header directives REPLACE, they do not merge. Any server
    # or location block that declares its own add_header loses every header
    # inherited from here. A block that overrides the CSP must therefore repeat
    # ALL of the headers below, not just the one it wants to change.
    #
    # Permissions-Policy: microphone stays enabled because the speech/STT feature
    # (Whisper, voice shell, microphone test) depends on it; geolocation is used
    # by the greeting service. Camera, screen capture, payment and USB are unused.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), display-capture=(), geolocation=(self), microphone=(self), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org; media-src 'self' blob: data:; connect-src 'self' wss: https: blob:; worker-src 'self' blob:; frame-ancestors 'self';" always;

    # Marketing - HTTPS Port 443 (root domain)
    server {
        listen 443 ssl;
        server_name klacks-software.ch www.klacks-software.ch ${SERVER_IP};

        ssl_certificate /etc/letsencrypt/live/klacks-software.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/klacks-software.ch/privkey.pem;

        # Marketing CSP: fonts/icons are self-hosted, no external CDNs required.
        # The other security headers must be repeated here: declaring add_header in
        # this block drops everything inherited from the http level.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), display-capture=(), geolocation=(self), microphone=(self), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' wss: https:; frame-ancestors 'self';" always;

        location = /docs {
            return 301 /docs/;
        }

        location /docs/ {
            proxy_pass http://klacks-docs;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /store {
            return 301 /store/$is_args$args;
        }

        location /store/ {
            proxy_pass http://klacks-marketplace;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        location / {
            proxy_pass http://klacks-marketing;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }

    # Klacks UI + API (Playground) - HTTPS Port 7643
    server {
