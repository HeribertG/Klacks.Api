    # Marketplace - HTTPS Port 7553
    server {
        listen 7553 ssl;
        server_name klacks-software.ch www.klacks-software.ch ${SERVER_IP};

        ssl_certificate /etc/letsencrypt/live/klacks-software.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/klacks-software.ch/privkey.pem;

        # Override global CSP to allow CDN resources (Bootstrap, Font Awesome).
        # All other security headers are repeated because add_header replaces
        # rather than merges the inherited set.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), display-capture=(), geolocation=(self), microphone=(self), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: blob:; font-src 'self' data: https://cdnjs.cloudflare.com; connect-src 'self' wss: https:; frame-ancestors 'self';" always;

        location / {
            proxy_pass http://klacks-marketplace;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }


    # DevKnowledge - HTTPS Port 8443
    server {
        listen 8443 ssl;
        server_name klacks-software.ch www.klacks-software.ch ${SERVER_IP};

        ssl_certificate /etc/letsencrypt/live/klacks-software.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/klacks-software.ch/privkey.pem;

        location /api/ {
            proxy_pass http://devknowledge-api/api/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        location / {
            proxy_pass http://devknowledge-ui;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }

    # HTTP Port 80 - ACME challenge + redirect to HTTPS
    server {
        listen 80;
        server_name klacks-software.ch www.klacks-software.ch play.klacks-software.ch ${SERVER_IP};

        # Let's Encrypt ACME HTTP-01 challenge — must be served on plain HTTP
        # so certbot can validate domain ownership during renewal.
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTP Port 3000 - Redirect to HTTPS
    server {
        listen 3000;
        server_name klacks-software.ch www.klacks-software.ch ${SERVER_IP};
        return 301 https://$host$request_uri;
    }

    # HTTP Port 5000 - Redirect to HTTPS API
    server {
        listen 5000;
        server_name klacks-software.ch www.klacks-software.ch ${SERVER_IP};
        return 301 https://$host:5443$request_uri;
    }
}
