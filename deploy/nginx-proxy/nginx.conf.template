        location /api/ {
            proxy_pass http://klacks-api/api/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        location /hubs/ {
            proxy_pass http://klacks-api;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # MCP endpoint (Streamable HTTP, stateless). A tools/call answer can arrive as a
        # text/event-stream that stays open for as long as the skill runs, so nothing in between may
        # buffer or compress it: proxy_buffering, proxy_cache and gzip are off and the timeouts are
        # long. Connection "" keeps the upstream keepalive (MCP needs no WebSocket upgrade).
        # Exact match on purpose: the stateless transport serves /mcp only, and a prefix would also
        # steal SPA routes that merely start with "mcp". The Authorization header (JWT, PAT or OAuth
        # access token) is never part of the redacted log_format above.
        location = /mcp {
            proxy_pass http://klacks-api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # OAuth 2.1 for MCP clients: RFC 9728 protected-resource metadata
        # (/.well-known/oauth-protected-resource, with or without the /mcp suffix) and RFC 8414
        # authorization-server metadata (/.well-known/oauth-authorization-server), both answered by
        # klacks-api. Without these locations the SPA fallback answers them with index.html.
        location /.well-known/oauth- {
            proxy_pass http://klacks-api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Built-in authorization server: /oauth/register (dynamic client registration),
        # /oauth/authorize (login + consent page) and /oauth/token. The SPA route /oauth2/callback
        # does not match this prefix. Authorization codes travel only in the redirect to the client
        # and in the /oauth/token POST body, neither of which is logged; a code= query parameter that
        # does reach the proxy is redacted by the log maps above.
        location /oauth/ {
            proxy_pass http://klacks-api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://klacks-api/health;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            proxy_pass http://klacks-ui;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }
    }
